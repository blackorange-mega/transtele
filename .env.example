# Copy this file to .env and fill in your token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# reply = post translation as a new message under the channel post (default)
# edit  = rewrite the original channel post in place
CHANNEL_MODE=reply

# --------------------------------------------------------------------------- #
# LLM translator (optional)
# --------------------------------------------------------------------------- #
# Leave LLM_BASE_URL empty and the bot works exactly as before, through the
# free MyMemory / Google Translate endpoints. Set it and the bot translates
# with an LLM instead, falling back to the free endpoints whenever the LLM is
# unreachable or answers with nothing.

# Ollama running on this machine (native API):
LLM_BASE_URL=http://localhost:11434
# Same Ollama through its OpenAI-compatible API:
# LLM_BASE_URL=http://localhost:11434/v1
# Ollama on another machine in your network:
# LLM_BASE_URL=http://192.168.1.20:11434
# A hosted OpenAI-compatible provider:
# LLM_BASE_URL=https://api.example.com/v1

LLM_MODEL=translategemma:27b

# Only needed for a remote provider that requires a key. Local Ollama needs none.
# LLM_API_KEY=sk-...

# auto = native Ollama API, or OpenAI-compatible when the URL contains /v1.
# Force it with "ollama" or "openai".
LLM_API=auto

# all  = LLM translates word lists and whole messages (default)
# text = LLM translates whole messages only; single words keep the dictionary
#        lookup, which is more accurate for bare vocabulary on small models
LLM_SCOPE=all

# Seconds to wait for the model. A cold 4B model on CPU can take a while.
LLM_TIMEOUT=60

# Prompts sent at the same time. One small model on one GPU likes 1-2.
LLM_CONCURRENCY=2

# 1 = free-endpoint backend prints up to 3 meanings per word instead of one
MULTI_SENSE=0
